# Copy to .env (never commit .env)
# Get a Grok key at https://console.x.ai (API Keys). Keys start with xai-
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-4.7
# Tried automatically if GROK_MODEL has no credits, is overloaded or is not found. Leave empty to disable.
GROK_FALLBACK_MODEL=grok-4.20
# Optional: Gemini key used ONLY for RAG embeddings (xAI has no embeddings API).
# Leave empty to use the built-in local embedder instead.
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
MOCK_AI=0
# Claims checked per request and how many run in parallel
MAX_CLAIMS=4
CLAIM_WORKERS=2
# Web search: auto | tavily | ddgs | grok
SEARCH_PROVIDER=auto
# React dev server origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional, e.g. ^https://.*\.lovable\.app$
CORS_ORIGIN_REGEX=
RAG_TOP_K=6
RAG_FETCH_PAGES=3
RAG_MIN_SCORE=0.45
OCR_LANG=eng
