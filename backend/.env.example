# Copy to .env (never commit .env)
GEMINI_API_KEY=your-gemini-api-key-here
# Pro models have NO free-tier quota (429 "limit: 0"). Use a Flash model unless billing is enabled.
GEMINI_MODEL=gemini-2.5-flash
# Tried automatically if GEMINI_MODEL has no quota or is not found. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
EMBED_MODEL=gemini-embedding-001
MOCK_AI=0
# Claims checked per request (each costs ~4 Gemini calls) and how many run in parallel
MAX_CLAIMS=4
CLAIM_WORKERS=2
# React dev server origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional, e.g. ^https://.*\.lovable\.app$
CORS_ORIGIN_REGEX=
RAG_TOP_K=6
RAG_FETCH_PAGES=3
RAG_MIN_SCORE=0.45
OCR_LANG=eng
